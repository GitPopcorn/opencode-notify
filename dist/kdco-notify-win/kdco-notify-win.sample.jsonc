// ============================================================================
// kdco-notify-win — SAMPLE template (INERT — never loaded by the plugin)
// ============================================================================
//
// ⚠  This file name contains ".sample" and is NOT in the plugin's
//    CONFIG_FILENAMES list, so it will NEVER be loaded automatically.
//
// To activate: copy this file as `kdco-notify-win.jsonc` to one of:
//   • <project>/.opencode/plugins/config/kdco-notify-win.jsonc  (project, P2)
//   • <plugin-dir>/config/kdco-notify-win.jsonc                 (slot, P6)
// Then edit as needed.
//
// Config priority chain (low -> high, deep-merged key by key):
//   P7  code DEFAULT_CONFIG                       (base)
//   P6  <plugin-dir>/config/kdco-notify-win.jsonc (empty slot; copy this file here)
//   P2  .opencode/plugins/config/kdco-notify-win.jsonc (project file)
//   P1+P3  opencode.json(c) `plugin` tuple options  (highest, official)
//
// Objects (sounds/quietHours/heartbeat/logging) are merged per-key; arrays
// are replaced wholesale. `logging` hot-reloads on file change; the rest
// applies on OpenCode restart.
// ============================================================================

{
	// Include sub-task (child) sessions in notifications. Default false:
	// only parent/root sessions notify, so sub-agent work doesn't spam.
	"notifyChildSessions": false,

	// Per-notification-kind Windows toast sound (Notification.* preset names).
	"sounds": {
		"idle": "Notification.Mail",
		"error": "Notification.Reminder",
		"permission": "Notification.SMS",
		"question": "Notification.IM",
		"network": "Notification.Mail",
		"cancelled": "Notification.Mail"
	},

	// Quiet hours: suppress notifications entirely during a window.
	// start > end means an overnight window (e.g. 22:00 -> 08:00).
	"quietHours": {
		"enabled": false,
		"start": "22:00",
		"end": "08:00"
	},

	// Network-interruption errors also play a short system beep (best-effort).
	"beepOnInterruption": true,

	// Prepend a "[yyyy-MM-dd HH:mm:ss]" timestamp line to the notification body.
	"showTimestamp": true,

	// Append a one-line summary of the latest tool steps to READY notifications.
	"showSummary": true,

	// Max number of recent tool steps folded into the summary line.
	"summarySteps": 3,

	// Color each notification theme with a distinct hero banner.
	"themedIcons": true,

	// Icon set: "flat" (full gradient) or "legacy" (square blue block + border).
	"iconTheme": "legacy",

	// Override every kind's sound with one Notification.* preset.
	"soundOverride": "",

	// What a toast click does: "off" | "program" | "native".
	"clickMode": "off",
	"clickProgram": "",
	"clickArgs": [],

	// Diagnostic file logging. Default is OFF (no disk writes).
	// For on-site diagnosis, set enabled to true and minLogLevel to "ALL":
	//   "logging": { "enabled": true, "minLogLevel": "ALL" }
	"logging": {
		"enabled": false,
		"minLogLevel": "WARN",
		"moduleLogLevels": {},
		"logDir": "",
		"logRetentionDays": 30,
		"logFlushMode": "hybrid",
		"logSyncCheckpointInterval": 5,
		"logBufferMaxEntries": 100,
		"logBufferFlushIntervalMs": 500
	},

	// A run stopped by the user (ESC / cancel) fires a distinct STOPPED BY YOU
	// toast. false makes ESC silent.
	"notifyCancelled": true,

	// Heartbeat watchdog for runs that end without ANY event reaching the plugin.
	"heartbeat": {
		"enabled": true,
		"intervalSec": 30,
		"stallSec": 120,
		"warnWhileStalled": false
	}
}
